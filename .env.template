STEAM_USER=your_steam_username
STEAM_PASSWORD=your_steam_password
REGISTRY=registry.gitlab.inria.fr/eurobin-horizon/code/ros2-vive-controller
TAG=latest

# General
ROS_DOMAIN_ID=2
LINEAR_SCALE=1.75 # Scale factor for linear position, adjust as needed for your setup

# Hardware Serials. Easier: run `make setup` and pick them in the web app. It saves them in
# config/station.yaml, which then wins over these values (they are only a fallback).
SERIAL_LEFT=LHR-97752221 # Replace with your left controller's serial number
SERIAL_RIGHT=LHR-4BB3817E # Replace with your right controller's serial number
# Teleop: where a new clutch stroke starts (every arm). 'tf' (default) re-reads the end effector
# from TF; 'last_command' continues from the last commanded pose, so a delayed robot TF cannot
# make the arm jump back to an old position when you clutch again.
# CLUTCH_REFERENCE=last_command
# Port of the setup web app (make setup), default 8800
# SETUP_PORT=8800

REFERENCE_LIGHTHOUSE_SERIAL=LHB-2E7D2119 # Replace with your reference lighthouse's serial number (The one that will be used as origin)

